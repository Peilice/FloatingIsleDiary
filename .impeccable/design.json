      "css": ".ds-btn-market{height:70px;padding:5px;border:none;background:#ffffff;border-radius:22px;box-shadow:0 6px 0 rgba(59,47,30,.16);cursor:pointer} .ds-btn-market span{display:flex;align-items:center;height:100%;box-sizing:border-box;padding:0 34px;background:#c4473d;border:3px solid #2b3a55;border-radius:17px;color:#fff;font-family:'Andika','Huninn','Segoe UI',sans-serif;font-weight:700;font-size:26px} .ds-btn-market:active{transform:scale(.97)} .ds-btn-market:focus-visible{outline:3px dashed #2b3a55;outline-offset:4px}"
