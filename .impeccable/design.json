  "components": [
    {
      "name": "貼紙卡 Sticker Card",
      "kind": "card",
      "refersTo": "sticker-card",
      "description": "答案卡：白色切割邊、墨線框、暖色落影、小角度。選錯變淡，選對蓋章。",
      "html": "<div class=\"ds-card\" tabindex=\"0\"><div class=\"ds-card-in\"><svg width=\"96\" height=\"96\" viewBox=\"0 0 96 96\"><circle cx=\"48\" cy=\"50\" r=\"34\" fill=\"#fbfaf5\" stroke=\"#2b3a55\" stroke-width=\"3\"/><circle cx=\"36\" cy=\"46\" r=\"4\" fill=\"#2b3a55\"/><circle cx=\"60\" cy=\"46\" r=\"4\" fill=\"#2b3a55\"/></svg><span class=\"ds-card-zh\">貓熊</span></div></div>",
      "css": ".ds-card{width:196px;height:214px;box-sizing:border-box;padding:10px;background:#ffffff;border-radius:28px;box-shadow:0 5px 0 rgba(59,47,30,.10), 0 9px 0 rgba(59,47,30,.10);transform:rotate(-2.5deg);cursor:pointer;transition:opacity .2s} .ds-card-in{height:100%;box-sizing:border-box;background:#fdf9f0;border:3px solid #2b3a55;border-radius:20px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px} .ds-card-zh{font-family:'Huninn','Noto Sans TC','Microsoft JhengHei','PingFang TC',sans-serif;font-size:20px;color:#4f5a6b} .ds-card:active{transform:rotate(-2.5deg) translateX(8px)} .ds-card:focus-visible{outline:3px dashed #2b3a55;outline-offset:4px}"
    },
    {
      "name": "主要貼紙按鈕 Go Button",
